---
import { ArrowRight } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import MortgageCalculator from '@/components/MortgageCalculator';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { cityPages, site } from '@/data/site';
import {
  absolute,
  agentSchema,
  breadcrumbSchema,
  faqSchema,
  serviceSchema,
  webPageSchema,
} from '@/lib/seo';

const title = 'Mortgage Calculator & Financing Guide | Adam the Realtor';
const description =
  'Estimate your monthly payment, buying power and closing costs, then get pre-approved with an Orange County lender. Guidance from Adam, a Century 21 agent.';
const canonical = absolute('/mortgage/');

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Mortgage', href: '/mortgage/' },
];

const faqs = [
  {
    q: 'How much do I need for a down payment in Orange County?',
    a: 'It depends on the loan program. Conventional loans can start lower with mortgage insurance, FHA loans are popular with smaller down payments, and VA loans may require no down payment for eligible buyers. Jumbo loans for higher-priced homes usually require a larger down payment. A lender will confirm what you qualify for.',
  },
  {
    q: 'How much house can I afford?',
    a: 'Lenders typically look at your debt-to-income ratio, credit profile, reserves and the loan program. A common target is keeping total housing costs and debts near 36–43% of gross monthly income. The affordability calculator above gives a starting range — not an approval.',
  },
  {
    q: 'What closing costs should I expect in Orange County?',
    a: 'Buyers commonly pay for loan origination, title and escrow, appraisal, recording, prepaid interest and insurance or tax reserves. A useful planning range is 2–5% of the purchase price, though the exact number depends on your lender, contract and credits negotiated with the seller.',
  },
  {
    q: 'Should I get pre-approved before touring homes?',
    a: 'Yes. A pre-approval clarifies your price range, strengthens your offer and lets you move quickly when the right home appears. It is not a final loan approval, and financing stays subject to the lender’s conditions.',
  },
  {
    q: 'Do you provide loans or connect me with a lender?',
    a: 'Adam is a real estate agent, not a lender, and does not originate loans. He helps you prepare, explains how financing affects your offer, and can introduce you to trusted lending professionals so you can compare options directly.',
  },
];

const schemas = [
  agentSchema(),
  webPageSchema({
    url: canonical,
    name: title,
    description,
    updated: new Date('2026-10-27'),
  }),
  serviceSchema({
    name: 'Mortgage preparation and lender introductions',
    description:
      'Guidance on down payments, affordability, closing costs and pre-approval, plus introductions to trusted lenders in Orange County.',
    url: canonical,
    serviceType: 'Mortgage readiness guidance',
    cities: cityPages.map((city) => city.name),
  }),
  breadcrumbSchema(crumbs),
  faqSchema(faqs, canonical),
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schemas}>
  <PageHero
    eyebrow="Home financing"
    h1="Mortgage & Finance Center"
    lede="Run the numbers before you tour homes. Estimate payments, buying power and cash to close, then get pre-approved with a lender you trust."
    crumbs={crumbs}
    ctas={[
      { label: 'Get Pre-Approved', href: '/contact/' },
      { label: 'Talk to Adam', href: site.phoneHref, variant: 'secondary' },
    ]}
  />

  <section id="calculator" class="scroll-mt-24 bg-background py-14 sm:py-16">
    <div class="container mx-auto px-6">
      <div class="mx-auto max-w-5xl">
        <div class="max-w-2xl">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-primary">
            Payment calculator
          </p>
          <h2 class="mt-3 text-3xl font-bold leading-tight text-foreground sm:text-[34px]" style="font-family: var(--font-heading)">
            Estimate your monthly payment
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Principal and interest are driven by price, down payment, rate and term. Property taxes and
            insurance are added as estimates so the number you see is closer to what you will actually pay
            each month.
          </p>
        </div>
        <div class="mt-8">
          <MortgageCalculator mode="payment" client:visible />
        </div>
      </div>
    </div>
  </section>

  <section id="affordability" class="scroll-mt-24 bg-secondary/60 py-14 sm:py-16">
    <div class="container mx-auto px-6">
      <div class="mx-auto max-w-5xl">
        <div class="max-w-2xl">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-primary">
            Affordability
          </p>
          <h2 class="mt-3 text-3xl font-bold leading-tight text-foreground sm:text-[34px]" style="font-family: var(--font-heading)">
            How much house can you afford?
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            A pre-approval number and a comfortable monthly payment are not always the same thing. We run
            both before you tour, so the search stays realistic.
          </p>
        </div>
        <div class="mt-8">
          <MortgageCalculator mode="affordability" client:visible />
        </div>
      </div>
    </div>
  </section>

  <section id="closing-costs" class="scroll-mt-24 py-14 sm:py-16">
    <div class="container mx-auto px-6">
      <div class="mx-auto max-w-5xl">
        <div class="max-w-2xl">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-primary">
            Cash to close
          </p>
          <h2 class="mt-3 text-3xl font-bold leading-tight text-foreground sm:text-[34px]" style="font-family: var(--font-heading)">
            Closing costs in Orange County
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Budget for more than the down payment. Loan fees, title and escrow, appraisal, recording and
            prepaid reserves are usually paid at closing, and some can be negotiated with the seller.
          </p>
        </div>
        <div class="mt-8">
          <MortgageCalculator mode="closing" client:visible />
        </div>

        <div class="mt-8 grid gap-6 rounded-2xl border border-border bg-card p-6 sm:grid-cols-3">
          <div>
            <h3 class="text-sm font-bold text-foreground" style="font-family: var(--font-heading)">
              Lender fees
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              Origination, underwriting and discount points vary by lender and loan program. Compare a Loan
              Estimate, not just an advertised rate.
            </p>
          </div>
          <div>
            <h3 class="text-sm font-bold text-foreground" style="font-family: var(--font-heading)">
              Title & escrow
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              California transactions typically use escrow and title companies. Fees are set by the provider
              and split according to the contract.
            </p>
          </div>
          <div>
            <h3 class="text-sm font-bold text-foreground" style="font-family: var(--font-heading)">
              Prepaids & reserves
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              You may prepay interest to month-end and fund tax and insurance reserves. These are real cash
              due at closing even though they are not fees.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background py-14 sm:py-16">
    <div class="container mx-auto px-6">
      <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-2">
        <div>
          <h2 class="text-2xl font-bold text-foreground sm:text-3xl" style="font-family: var(--font-heading)">
            Get pre-approved before you tour
          </h2>
          <ol class="mt-5 space-y-4">
            <li class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-bold text-primary-foreground">1</span>
              <p class="text-sm leading-relaxed text-muted-foreground">
                <strong class="text-foreground">Share your goals.</strong> We talk budget, timeline, down
                payment and the monthly payment you are comfortable with.
              </p>
            </li>
            <li class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-bold text-primary-foreground">2</span>
              <p class="text-sm leading-relaxed text-muted-foreground">
                <strong class="text-foreground">Compare lenders.</strong> I can introduce you to trusted
                professionals so you can compare rates, fees and programs directly.
              </p>
            </li>
            <li class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-bold text-primary-foreground">3</span>
              <p class="text-sm leading-relaxed text-muted-foreground">
                <strong class="text-foreground">Shop with a real number.</strong> We set your search range
                and write offers that protect your deposit and your budget.
              </p>
            </li>
          </ol>
          <a href="/buyers/" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:text-primary/80">
            Read the full buyers guide
            <ArrowRight size={15} aria-hidden="true" />
          </a>
        </div>

        <div class="rounded-2xl border border-border bg-secondary/50 p-6">
          <h2 class="text-2xl font-bold text-foreground sm:text-3xl" style="font-family: var(--font-heading)">
            Loan programs to discuss
          </h2>
          <dl class="mt-5 space-y-4 text-sm leading-relaxed">
            <div>
              <dt class="font-semibold text-foreground">Conventional</dt>
              <dd class="text-muted-foreground">Flexible down payments; mortgage insurance may apply below 20%.</dd>
            </div>
            <div>
              <dt class="font-semibold text-foreground">FHA</dt>
              <dd class="text-muted-foreground">Lower down payment options with mortgage insurance premiums.</dd>
            </div>
            <div>
              <dt class="font-semibold text-foreground">VA</dt>
              <dd class="text-muted-foreground">For eligible veterans and service members; may allow no down payment.</dd>
            </div>
            <div>
              <dt class="font-semibold text-foreground">Jumbo</dt>
              <dd class="text-muted-foreground">For higher loan amounts common in coastal Orange County; stricter reserves.</dd>
            </div>
            <div>
              <dt class="font-semibold text-foreground">ARM</dt>
              <dd class="text-muted-foreground">A fixed introductory rate that adjusts later; plan for the adjustment.</dd>
            </div>
          </dl>
          <p class="mt-5 border-t border-border pt-4 text-xs leading-relaxed text-muted-foreground">
            Adam is a real estate agent, not a lender, and does not originate loans. All financing is
            subject to the lender’s approval.
          </p>
        </div>
      </div>
    </div>
  </section>

  <FaqList faqs={faqs} heading="Mortgage questions, answered" />

  <CtaBand
    heading="Ready to turn the estimate into a plan?"
    body="Send your target price and timeline, and I will help you line up financing, neighborhoods and a search that fits your budget."
  />
</BaseLayout>
