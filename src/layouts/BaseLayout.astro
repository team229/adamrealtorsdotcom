---
import '../styles/global.css';
import Header from '@/components/Header';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** JSON-LD structured data injected into the head. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = `${site.url}/images/og-adam-the-realtor.jpg`,
  ogImageAlt = 'Adam Shaaban — Southern California real estate agent',
  canonical = new URL(Astro.url.pathname, site.url).href,
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;

const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical === `${site.url}/` && (
      <link rel="preload" as="image" href="/images/hero-socal.webp" fetchpriority="high" />
    )}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}
    <meta name="theme-color" content="#1a3a6b" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@AdamTheRealtor" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600&display=swap"
    />

    <noscript>
      <style>
        [data-reveal],
        [data-reveal='load'] {
          opacity: 1 !important;
          transform: none !important;
          animation: none !important;
        }
      </style>
    </noscript>

    {
      schemas.map((entry) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(entry).replace(/</g, '\\u003c')}
        />
      ))
    }
  </head>
  <body class="min-h-screen bg-background flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-primary focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>
    <Header pathname={Astro.url.pathname} client:load />
    <main id="main" class="flex-1 pb-20 lg:pb-0">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  /**
   * Scroll reveal.
   *
   * A single IntersectionObserver flips every [data-reveal] element to its
   * visible state the first time it enters the viewport. Runs once on load
   * and again after any client-side navigation.
   */
  function initReveal() {
    const targets = document.querySelectorAll<HTMLElement>(
      '[data-reveal]:not([data-reveal="visible"]):not([data-reveal="load"])',
    );

    if (!('IntersectionObserver' in window)) {
      targets.forEach((el) => el.setAttribute('data-reveal', 'visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.setAttribute('data-reveal', 'visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );

    targets.forEach((el) => observer.observe(el));
  }

  initReveal();
  document.addEventListener('astro:after-swap', initReveal);
</script>
