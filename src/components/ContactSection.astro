---
import ContactForm from '@/components/ContactForm';
import AgentCard from '@/components/AgentCard.astro';
import ContactMethods from '@/components/ContactMethods.astro';
import PromiseCard from '@/components/PromiseCard.astro';
import { contact } from '@/data/site';
---

<section id="contact-form" class="scroll-mt-24 bg-background py-16">
  <div class="container mx-auto px-6">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-6 lg:grid-cols-5 lg:gap-8">
      <!-- Left column: the enquiry form + the service promise -->
      <div class="flex flex-col gap-6 lg:col-span-3">
        <div
          data-reveal
          class="overflow-hidden rounded-2xl border border-border bg-card shadow-[0_8px_32px_rgba(15,23,42,0.08)]"
        >
          <div class="border-b border-border px-6 pb-4 pt-6 md:px-8 md:pt-7">
            <h2
              class="text-xl font-bold text-foreground md:text-[22px]"
              style="font-family: var(--font-heading)"
            >
              {contact.formTitle}
            </h2>
            <p class="mt-1 text-sm text-muted-foreground">
              Tell me a little about what you need — I reply to every message personally.
            </p>
          </div>
          <ContactForm client:load />
        </div>

        <div data-reveal>
          <PromiseCard />
        </div>
      </div>

      <!-- Right column: who you're talking to + direct contact details -->
      <div class="flex flex-col gap-6 lg:col-span-2">
        <div data-reveal>
          <AgentCard />
        </div>

        <div data-reveal>
          <ContactMethods />
        </div>
      </div>
    </div>
  </div>
</section>
