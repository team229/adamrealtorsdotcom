---
import { Plus } from 'lucide-react';

interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
  intro?: string;
}

const {
  faqs,
  heading = 'Frequently Asked Questions',
  intro = "Straight answers to the questions buyers and sellers ask most. If yours isn't here, call or text and I'll answer it directly.",
} = Astro.props;
---

<section id="faq" class="scroll-mt-24 bg-secondary/70 py-16 sm:py-20">
  <div class="container mx-auto px-6">
    <div class="mx-auto max-w-3xl">
      <div data-reveal class="mb-8">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-primary">FAQ</p>
        <h2
          class="mt-3 text-3xl font-bold leading-tight text-foreground sm:text-[34px]"
          style="font-family: var(--font-heading)"
        >
          {heading}
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground">{intro}</p>
      </div>

      <div class="divide-y divide-border border-y border-border">
        {
          faqs.map((faq, index) => (
            <details class="group py-1" open={index === 0}>
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-4 text-left [&::-webkit-details-marker]:hidden">
                <h3 class="text-base font-semibold leading-snug text-foreground pr-2">
                  {faq.q}
                </h3>
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border text-muted-foreground transition-transform group-open:rotate-45">
                  <Plus size={14} aria-hidden="true" />
                </span>
              </summary>
              <p class="pb-5 pr-10 text-[15px] leading-relaxed text-muted-foreground">
                {faq.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
