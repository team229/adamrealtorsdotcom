---
import Faq from '@/components/Faq';
---

<section class="bg-muted py-20">
  <div class="container mx-auto px-6">
    <div class="mx-auto max-w-2xl">
      <div data-reveal class="mb-10 text-center">
        <span
          class="text-[11px] font-semibold uppercase tracking-[0.2em] text-primary"
        >
          FAQ
        </span>
        <h2
          class="mt-3 text-3xl font-bold text-foreground md:text-[34px]"
          style="font-family: var(--font-heading)"
        >
          Common Questions
        </h2>
        <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-muted-foreground">
          Everything clients ask before their first consultation. Still unsure?
          Send a message and I'll walk you through it.
        </p>
      </div>

      <div data-reveal>
        <Faq client:load />
      </div>
    </div>
  </div>
</section>
