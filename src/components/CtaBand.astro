---
import { ArrowRight, Phone } from 'lucide-react';
import { site } from '@/data/site';

interface Props {
  heading?: string;
  body?: string;
  city?: string;
}

const {
  heading = 'Ready to make your next move?',
  body = 'Tell me what you are looking for, where you want to be, and what matters most. I will help you turn that into a plan — starting with a conversation, not a contract.',
  city,
} = Astro.props;
---

<section class="relative overflow-hidden bg-[hsl(217,60%,16%)] py-16 text-white sm:py-20">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -right-20 -top-24 h-[320px] w-[320px] rounded-full bg-accent/20 blur-3xl"></div>
    <div class="absolute -bottom-24 left-0 h-[260px] w-[320px] rounded-full bg-primary/40 blur-3xl"></div>
  </div>

  <div class="container relative z-10 mx-auto px-6">
    <div class="mx-auto flex max-w-5xl flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
      <div class="max-w-2xl">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
          {city ? `${city} · Century 21 Affiliated` : 'Century 21 Affiliated'}
        </p>
        <h2
          class="mt-3 text-3xl font-bold leading-tight sm:text-[38px]"
          style="font-family: var(--font-heading)"
        >
          {heading}
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-white/70 sm:text-base">{body}</p>
      </div>

      <div class="flex w-full shrink-0 flex-col gap-3 sm:w-auto sm:flex-row lg:flex-col">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-[#2a1f12] transition-all hover:-translate-y-0.5 hover:bg-accent/90"
        >
          Contact Adam
          <ArrowRight size={16} aria-hidden="true" />
        </a>
        <a
          href={site.phoneHref}
          class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-white/50 hover:bg-white/10"
        >
          <Phone size={15} aria-hidden="true" />
          {site.phone}
        </a>
      </div>
    </div>
  </div>
</section>
