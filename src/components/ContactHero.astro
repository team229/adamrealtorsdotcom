---
import { contact } from '@/data/site';
---

<section class="relative overflow-hidden bg-background pb-14 pt-32 sm:pt-36">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute left-1/2 top-0 h-[420px] w-[760px] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl"
    >
    </div>
    <div
      class="absolute left-1/2 top-24 h-[220px] w-[520px] -translate-x-1/2 rounded-full bg-accent/10 blur-3xl"
    >
    </div>
  </div>

  <div class="container relative z-10 mx-auto px-6">
    <div class="mx-auto max-w-2xl text-center">
      <div data-reveal="load">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/[0.06] px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-primary"
        >
          <span class="relative flex h-1.5 w-1.5">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"
            >
            </span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent">
            </span>
          </span>
          {contact.hero.badge}
        </span>
      </div>

      <h1
        data-reveal="load"
        data-reveal-delay="1"
        class="mt-6 text-5xl font-bold leading-[1.1] text-foreground md:text-6xl"
        style="white-space: pre-line; font-family: var(--font-heading)"
      >
        {contact.hero.headline}
      </h1>

      <p
        data-reveal="load"
        data-reveal-delay="2"
        class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground"
        style="white-space: pre-line"
      >
        {contact.hero.subheadline}
      </p>
    </div>

    <div
      data-reveal
      class="mx-auto mt-12 grid max-w-2xl grid-cols-2 gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-4"
    >
      {
        contact.stats.map((stat) => (
          <div class="bg-card px-4 py-6 text-center transition-colors hover:bg-secondary/60">
            <div
              class="text-2xl font-bold text-foreground md:text-[28px] md:leading-tight"
              style="font-family: var(--font-heading)"
            >
              {stat.value}
            </div>
            <div class="mt-1.5 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
              {stat.label}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
