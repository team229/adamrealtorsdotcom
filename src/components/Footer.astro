---
import { Mail, Phone } from 'lucide-react';
import {
  FacebookIcon,
  InstagramIcon,
  LinkedInIcon,
  XIcon,
  YouTubeIcon,
} from '@/components/icons/SocialIcons';
import {
  footerLinks,
  site,
  socials,
} from '@/data/site';

const year = new Date().getFullYear();

const socialIcons = {
  instagram: InstagramIcon,
  x: XIcon,
  facebook: FacebookIcon,
  linkedin: LinkedInIcon,
  youtube: YouTubeIcon,
};
---

<footer class="bg-secondary border-t border-border pb-20 lg:pb-0">
  <div class="container mx-auto px-6 py-16">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a class="inline-block mb-4" href="/">
          <span
            class="text-2xl font-bold text-primary"
            style="font-family: var(--font-heading)">{site.name}</span
          >
        </a>
        <p class="text-sm text-muted-foreground leading-relaxed mb-4">
          Your Southern California real estate agent. Buy, sell, and get expert
          guidance from Adam.
        </p>

        <div
          class="flex flex-col gap-2 mb-6 text-sm text-muted-foreground"
        >
          <a
            href={site.phoneHref}
            class="flex items-center gap-2 transition-colors hover:text-primary"
          >
            <Phone size={14} />
            <span>{site.phone}</span>
          </a>
          <a
            href={`mailto:${site.email}`}
            class="flex items-center gap-2 transition-colors hover:text-primary"
          >
            <Mail size={14} />
            <span>{site.email}</span>
          </a>
          <div class="flex items-start gap-2">{site.address}</div>
        </div>

        <div class="flex items-center gap-3">
          {
            socials.map((social) => {
              const Icon = socialIcons[social.icon];
              return (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="flex h-9 w-9 items-center justify-center rounded-full transition-colors"
                  style={`background:${social.bg}`}
                >
                  {Icon && <Icon size={16} color="#fff" />}
                </a>
              );
            })
          }
        </div>
      </div>

      <div>
        <h3 class="mb-5 text-sm font-semibold text-foreground">Buy</h3>
        <ul class="flex flex-col gap-3">
          {
            footerLinks.buy.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="mb-5 text-sm font-semibold text-foreground">Sell</h3>
        <ul class="flex flex-col gap-3">
          {
            footerLinks.sell.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-border">
    <div
      class="container mx-auto px-6 py-5 flex flex-col items-center gap-4 md:flex-row md:justify-between"
    >
      <p class="text-xs text-muted-foreground">
        © {year} {site.name}. All rights reserved. {site.dre} · {site.brokerage}
      </p>
      <nav
        class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 md:gap-6"
        aria-label="Footer links"
      >
        {
          footerLinks.legal.map((link) => (
            <a
              href={link.href}
              class="text-xs text-muted-foreground transition-colors hover:text-foreground"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
