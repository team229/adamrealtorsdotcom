---
import { ArrowUpRight, Mail, Phone } from 'lucide-react';
import { site } from '@/data/site';

const guides = [
  { label: 'Buyers guide', href: '/buyers/' },
  { label: "Sellers guide", href: '/sellers/' },
  { label: 'About Adam', href: '/about/' },
];
---

<aside class="hidden lg:block">
  <div class="sticky top-24 space-y-4">
    <div class="rounded-2xl border border-border bg-card p-5 shadow-sm">
      <div class="flex items-center gap-3">
        <img
          src={site.portrait}
          alt={`${site.agentFullName}, ${site.agentTitle}`}
          width="64"
          height="64"
          loading="lazy"
          class="h-16 w-16 rounded-full object-cover object-[50%_22%]"
        />
        <div>
          <p
            class="text-base font-bold leading-tight text-foreground"
            style="font-family: var(--font-heading)"
          >
            {site.agentFullName}
          </p>
          <p class="text-xs text-muted-foreground">{site.brokerage} · {site.dre}</p>
        </div>
      </div>

      <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
        Questions about a specific home, street or price? Call or text and I'll give you a
        straight answer — no pressure.
      </p>

      <div class="mt-4 flex flex-col gap-2">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Contact Adam
          <ArrowUpRight size={15} aria-hidden="true" />
        </a>
        <a
          href={site.phoneHref}
          class="inline-flex items-center justify-center gap-2 rounded-full border border-border px-4 py-2.5 text-sm font-semibold text-foreground transition-colors hover:border-primary/30 hover:text-primary"
        >
          <Phone size={14} aria-hidden="true" />
          {site.phone}
        </a>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center justify-center gap-2 rounded-full border border-border px-4 py-2.5 text-xs font-medium text-muted-foreground transition-colors hover:border-primary/30 hover:text-primary"
        >
          <Mail size={13} aria-hidden="true" />
          Email Adam
        </a>
      </div>
    </div>

    <div class="rounded-2xl border border-border bg-secondary/60 p-5">
      <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">
        Keep exploring
      </h2>
      <ul class="mt-3 space-y-2.5">
        {
          guides.map((guide) => (
            <li>
              <a
                href={guide.href}
                class="flex items-center justify-between gap-2 text-sm font-medium text-foreground transition-colors hover:text-primary"
              >
                {guide.label}
                <ArrowUpRight size={14} className="text-muted-foreground" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</aside>
