---
import { InstagramIcon, LinkedInIcon, TwitterIcon, YouTubeIcon } from '@/components/icons/SocialIcons';
import { site } from '@/data/site';

const agentSocials = [
  { label: 'Instagram', href: 'https://instagram.com', Icon: InstagramIcon },
  { label: 'Twitter', href: 'https://twitter.com', Icon: TwitterIcon },
  { label: 'LinkedIn', href: 'https://linkedin.com', Icon: LinkedInIcon },
  { label: 'YouTube', href: 'https://youtube.com', Icon: YouTubeIcon },
];
---

<article
  class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition-shadow duration-300 hover:shadow-lg"
>
  <div class="relative h-60 overflow-hidden">
    <img
      src={site.portrait}
      alt={`${site.agentFullName} — ${site.agentTitle}`}
      class="h-full w-full object-cover object-top transition-transform duration-700 hover:scale-[1.03]"
      loading="lazy"
      width={600}
      height={400}
    />
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#13131A]/70 via-transparent to-transparent"
    >
    </div>

    <div
      class="absolute bottom-3 right-3 flex items-center gap-1 rounded-full border border-white/15 bg-black/55 px-2.5 py-1.5 backdrop-blur-sm"
    >
      {
        Array.from({ length: 5 }).map(() => (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="11"
            height="11"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="text-accent"
            aria-hidden="true"
          >
            <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.123 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" />
          </svg>
        ))
      }
      <span class="ml-0.5 text-[10px] font-semibold text-white/90">5.0</span>
    </div>
  </div>

  <div class="p-5">
    <div class="mb-3 flex items-start justify-between gap-3">
      <div>
        <h3
          class="text-base font-bold text-foreground"
          style="font-family: var(--font-heading)"
        >
          {site.agentName}
        </h3>
        <p class="text-xs text-muted-foreground">{site.agentTitle}</p>
      </div>
      <span
        class="shrink-0 whitespace-nowrap rounded-full border border-accent-strong/25 bg-accent-strong/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-accent-strong"
      >
        {site.brokerage}
      </span>
    </div>

    <div class="flex flex-col gap-2 text-sm leading-relaxed text-muted-foreground">
      {
        site.agentBio.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }
    </div>

    <div class="mt-4 flex items-center gap-2 border-t border-border pt-4">
      {
        agentSocials.map(({ label, href, Icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            class="flex h-8 w-8 items-center justify-center rounded-full border border-border text-muted-foreground transition-all hover:-translate-y-0.5 hover:border-primary/30 hover:text-primary"
          >
            <Icon size={13} />
          </a>
        ))
      }
    </div>
  </div>
</article>
