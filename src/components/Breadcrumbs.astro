---
import type { Crumb } from '@/lib/seo';

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/55">
    {
      crumbs.map((crumb, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && (
            <span aria-hidden="true" class="text-white/25">
              /
            </span>
          )}
          {index === crumbs.length - 1 ? (
            <span aria-current="page" class="text-white/80">
              {crumb.name}
            </span>
          ) : (
            <a href={crumb.href} class="transition-colors hover:text-white">
              {crumb.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
